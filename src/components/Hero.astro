---
import { site } from '../lib/site';

// Ink extents of each line at font-size 100px in the shipped display face,
// measured with canvas so a trailing period's sidebearing does not lie about
// where the line visually ends. Sizing on the ink, and pulling each line left
// by its own left sidebearing, puts every line flush on both margins.
// `over` is an optical overshoot in per-mille of the font size: a round letter
// sitting exactly on the margin reads as inset, so C and O hang a hair left.
const ink: Record<string, { left: number; right: number; over: number }> = {
  'Hundreds of': { left: 4.95, right: 377.1, over: 0 },
  'creatives.': { left: 4.3, right: 303, over: 1.1 },
  'One day.': { left: 4.3, right: 238, over: 1.1 },
};
const fallback = { left: 4.6, right: 320, over: 0 };
const style = (line: string, size: number) => {
  const m = ink[line] ?? fallback;
  return `--size: ${size.toFixed(3)}cqw; --lead: ${((-(m.left + m.over) * size) / 100).toFixed(3)}cqw`;
};

const lines = site.hero.lines;
const head = lines.slice(0, -1);
const last = lines[lines.length - 1] ?? '';
---
<section id="top" class="hero">
  <div class="container">
    <div class="hero__block">
      <h1 class="hero__headline h-display">
        {head.map((line) => {
          const m = ink[line] ?? fallback;
          return <span class="hero__line" style={style(line, 10000 / m.right)}>{line}</span>;
        })}
        <span class="hero__last">
          <span class="hero__line" style={style(last, 10000 / (ink[last] ?? fallback).right)}>{last}</span>
          {/* the collision is the idea: the drawn city name is written across
              the last line and runs off both margins, not queued underneath */}
          <img
            class="hero__brussels"
            src="/marks/brussels-ink.png"
            alt="Brussels."
            width="1929"
            height="499"
          />
        </span>
      </h1>
    </div>
    <div class="hero__foot">
      <p class="hero__intro">{site.hero.intro}</p>
      <div class="hero__actions">
        <a class="link" href={site.instagramUrl} rel="noopener" target="_blank">{site.hero.instagramLabel}</a>
        <a class="link" href={site.bruzzUrl} rel="noopener" target="_blank">{site.hero.bruzzLabel}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(16px, 2.2vw, 32px) clamp(40px, 5vw, 76px); }

  /* the query container is the bare measure, with no padding of its own, so
     1cqw is exactly 1% of the width the headline has to fill */
  .hero__block { container-type: inline-size; }

  .hero__headline {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    /* cap height in this face is 0.8075em, so a line box of 0.815 hugs the
       caps and the gap below is the only space between the bars */
    gap: 0.6cqw;
    color: var(--red);
  }
  /* sized to the measure, so it must never be allowed to wrap */
  .hero__line {
    display: block;
    font-size: var(--size);
    line-height: 0.815;
    white-space: nowrap;
    word-spacing: -0.05em;
    margin-left: var(--lead);
  }

  /* The drawn city name is the fourth line of the sentence, on the column and
     at the measure, overshooting the right margin the way a hand does. It was
     tried as an overprint across "One day." and the collision cost more in
     legibility than it bought in energy. */
  .hero__last { display: block; }
  .hero__brussels { width: 104cqw; max-width: none; margin: 0.6cqw 0 0 -0.6cqw; }

  .hero__foot { margin-top: clamp(34px, 4vw, 60px); }
  .hero__intro {
    max-width: 34ch;
    font-size: var(--fs-lead);
    line-height: 1.2;
    margin: 0 0 clamp(20px, 2.4vw, 30px);
  }
  .hero__actions { display: flex; align-items: baseline; gap: clamp(20px, 2.4vw, 40px); flex-wrap: wrap; }

  @media (max-width: 700px) {
    .hero__brussels { width: 102cqw; }
  }
</style>
