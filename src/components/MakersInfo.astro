---
import { site } from '../lib/site';
const { heading, steps, closing, note } = site.makers;

---
<section id="makers" class="makers">
  <div class="makers__head spine">
    <h2 class="label spine__left">{heading}</h2>
  </div>
  <div class="makers__rows">
    {steps.map((step, i) => (
      <div class="makers__row spine">
        <h3 class="h-display makers__title spine__left">{step.title}</h3>
        <div class="makers__copy spine__right">
          <p>{step.text}</p>
          {i === 1 && <p class="makers__note">{note}</p>}
          {i === steps.length - 1 && <p class="makers__note">{closing}</p>}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .makers { padding-block: var(--pad-mid) var(--pad-tight); }
  .makers__head { margin-bottom: clamp(12px, 1.4vw, 18px); }
  .makers__rows { display: grid; }
  .makers__row {
    position: relative;
    align-items: start;
    padding: 0 0 clamp(24px, 2.8vw, 40px);
    /* an equal row height, so the rhythm is the section's and not the copy's */
    min-height: clamp(140px, 15vw, 230px);
  }
  /* one size and one tracking across the three rows: stretching each title to
     the column made the wider ones look loose next to the narrower ones */
  .makers__title {
    /* held just under the width of the longest title, so every row is one line */
    font-size: clamp(34px, 6.5vw, 94px);
    line-height: 0.86;
    white-space: nowrap;
    color: var(--red);
    margin: 0;
  }
  /* the prose starts on the title's cap line, not below it */
  .makers__copy { padding-top: 5px; }
  .makers__copy { font-size: clamp(18px, 1.5vw, 21px); }
  .makers__copy p { margin: 0 0 0.7em; }
  .makers__note { font-weight: 600; }

  @media (max-width: 900px) {
    .makers__title { margin-bottom: 14px; }
    .makers__copy { padding-top: 0; }
  }
</style>
